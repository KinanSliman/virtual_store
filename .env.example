# PostgreSQL connection string used by the app, drizzle-kit, and the seed script.
# A local instance in development:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/virtual_store

# When pointing at Neon, use the pooled host here (the one containing
# "-pooler") and keep the direct host below for running migrations.
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
